rules_version = '2';
// NatureGram Firestore security rules
// Principles: least privilege, owner-only content edits, counters that can only
// move by the caller's own contribution, admin via custom claim or verified email.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function isAnon() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isMember() { return signedIn() && !isAnon(); }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email == 'ram@iitj.ac.in' && request.auth.token.email_verified == true)
      );
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isStr(v, max) { return v is string && v.size() <= max; }
    function optStr(field, max) { return !(field in incoming()) || incoming()[field] == null || isStr(incoming()[field], max); }

    // Counter may move by exactly +/-1 and never below zero
    function stepOne(field) {
      let before = existing().get(field, 0);
      let after = incoming().get(field, 0);
      return after is int && after >= 0 && (after == before + 1 || after == before - 1);
    }

    // The likes array may only gain or lose the caller's own uid
    function ownLikeToggle() {
      let before = existing().get('likes', []).toSet();
      let after = incoming().get('likes', []).toSet();
      let added = after.difference(before);
      let removed = before.difference(after);
      return incoming().get('likes', []).size() == after.size() && (
        (added == [request.auth.uid].toSet() && removed.size() == 0) ||
        (removed == [request.auth.uid].toSet() && added.size() == 0)
      );
    }

    // A report may only add the caller's own uid and mark the post pending
    function ownReport() {
      let before = existing().get('reports', []).toSet();
      let after = incoming().get('reports', []).toSet();
      return after.difference(before) == [request.auth.uid].toSet()
        && before.difference(after).size() == 0
        && incoming().reportStatus == 'pending';
    }

    // likeCount may only move with the caller's own like document (batched write)
    function likeCounterStep(postPath) {
      let before = existing().get('likeCount', 0);
      let after = incoming().get('likeCount', 0);
      return after is int && after >= 0 && (
        (after == before + 1
          && existsAfter(/databases/$(database)/documents/ecosystem_feed/$(postPath)/likes/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/ecosystem_feed/$(postPath)/likes/$(request.auth.uid)))
        ||
        (after == before - 1
          && !existsAfter(/databases/$(database)/documents/ecosystem_feed/$(postPath)/likes/$(request.auth.uid))
          && exists(/databases/$(database)/documents/ecosystem_feed/$(postPath)/likes/$(request.auth.uid)))
      );
    }

    // Fields an author may never set/alter directly on a post
    function protectedPostKeys() {
      return ['userId', 'likes', 'likeCount', 'commentCount', 'reports', 'reportStatus', 'reportCount', 'timestamp', 'moderation'];
    }

    // ------------------------------------------------------------------ users
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if isAdmin() || (signedIn() && request.query.limit <= 50);
      allow create: if isOwner(userId)
        && incoming().uid == userId
        && !incoming().keys().hasAny(['admin', 'role', 'verified', 'followersCount', 'followingCount'])
        && isStr(incoming().username, 40)
        && optStr('bio', 300) && optStr('avatarUrl', 2048) && optStr('displayName', 60);
      allow update: if isAdmin()
        || (isOwner(userId)
            && !changedKeys().hasAny(['uid', 'admin', 'role', 'verified', 'joinedAt', 'followersCount'])
            && (!('followingCount' in changedKeys()) || stepOne('followingCount'))
            && optStr('username', 40) && optStr('usernameLower', 40) && optStr('bio', 300) && optStr('avatarUrl', 2048) && optStr('displayName', 60))
        // Followers counter: only moves with the caller's own follower doc (batched write)
        || (isMember() && !isOwner(userId)
            && changedKeys().hasOnly(['followersCount'])
            && stepOne('followersCount')
            && (
              (incoming().followersCount > existing().get('followersCount', 0)
                && existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && !exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)))
              ||
              (incoming().followersCount < existing().get('followersCount', 0)
                && !existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)))
            ));
      allow delete: if isOwner(userId) || isAdmin();

      match /drafts/{draftId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Private per-user data (settings, precise locations, consent)
      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) && changedKeys().hasOnly(['isRead']);
        allow create: if isAdmin() || (
          isMember() && !isOwner(userId)
          && incoming().senderId == request.auth.uid
          && incoming().type in ['like', 'comment', 'follow', 'mention', 'reply', 'message', 'identification']
          && isStr(incoming().message, 300)
          && optStr('senderName', 60) && optStr('postId', 128) && optStr('senderAvatar', 2048)
          && incoming().isRead == false
          && incoming().keys().hasOnly(['type', 'message', 'postId', 'senderId', 'senderName', 'senderAvatar', 'timestamp', 'isRead'])
        );
      }

      // Social graph: users/{A}/following/{B} and users/{B}/followers/{A}
      match /following/{targetId} {
        allow read: if signedIn();
        allow create, delete: if isOwner(userId) && isMember() && targetId != userId;
      }
      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, delete: if isOwner(followerId) && isMember() && followerId != userId;
      }

      match /blocked/{targetId} {
        allow read, write: if isOwner(userId);
      }
      match /saved/{postId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ------------------------------------------------- themes (public, admin-managed)
    match /themes/{themeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /daily_themes/{dateStr} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------- naturalist memories (private)
    match /naturalist_memories/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ------------------------------------------------- posts
    match /ecosystem_feed/{postId} {
      allow read: if existing().isPublic == true || isOwner(existing().userId) || isAdmin();

      allow create: if isMember()
        && incoming().userId == request.auth.uid
        && incoming().isPublic is bool
        && incoming().get('likes', []).size() == 0
        && incoming().get('likeCount', 0) == 0
        && incoming().get('commentCount', 0) == 0
        && incoming().get('reports', []).size() == 0
        && incoming().get('reportStatus', 'safe') == 'safe'
        && !('rawLocation' in incoming())
        && optStr('caption', 2200) && optStr('title', 200) && optStr('description', 5000);

      allow update: if isAdmin()
        || (isOwner(existing().userId)
            && !changedKeys().hasAny(protectedPostKeys())
            && (incoming().get('rawLocation', null) == null || !('rawLocation' in changedKeys()))
            && optStr('caption', 2200) && optStr('title', 200) && optStr('description', 5000))
        || (signedIn() && changedKeys().hasOnly(['likes']) && ownLikeToggle())
        || (signedIn() && changedKeys().hasOnly(['likeCount']) && likeCounterStep(postId))
        || (signedIn() && changedKeys().hasOnly(['commentCount']) && stepOne('commentCount'))
        || (isMember() && changedKeys().hasOnly(['reports', 'reportStatus', 'reportCount']) && ownReport());

      // One like document per explorer (id = uid); readable for "liked by" lists
      match /likes/{likerId} {
        allow read: if get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.isPublic == true
          || isOwner(get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.userId)
          || isOwner(likerId) || isAdmin();
        allow create: if isOwner(likerId) && incoming().userId == request.auth.uid
          && incoming().keys().hasOnly(['userId', 'createdAt'])
          && existsAfter(/databases/$(database)/documents/ecosystem_feed/$(postId))
          && getAfter(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.get('likeCount', 0) == get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.get('likeCount', 0) + 1;
        allow delete: if (isOwner(likerId)
          && getAfter(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.get('likeCount', 0) == get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.get('likeCount', 0) - 1)
          || isAdmin();
      }

      allow delete: if isOwner(existing().userId) || isAdmin();

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.isPublic == true
          || isOwner(get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.userId)
          || isAdmin();
        allow create: if isMember()
          && incoming().userId == request.auth.uid
          && isStr(incoming().text, 1000) && incoming().text.size() > 0
          && optStr('userName', 60) && optStr('parentId', 128) && optStr('avatarUrl', 2048)
          && incoming().keys().hasOnly(['userId', 'userName', 'text', 'timestamp', 'parentId', 'avatarUrl']);
        allow update: if isOwner(existing().userId)
          && changedKeys().hasOnly(['text', 'editedAt'])
          && isStr(incoming().text, 1000) && incoming().text.size() > 0;
        allow delete: if isOwner(existing().userId)
          || isOwner(get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.userId)
          || isAdmin();
      }

      // Community identification: one ID per explorer per post (agree or suggest)
      match /identifications/{identifierId} {
        allow read: if get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.isPublic == true
          || isOwner(get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.userId)
          || isAdmin();
        allow create, update: if isOwner(identifierId) && isMember()
          && isStr(incoming().name, 80) && incoming().name.size() > 0
          && optStr('scientificName', 80) && optStr('note', 280) && optStr('userName', 60)
          && incoming().keys().hasOnly(['name', 'scientificName', 'note', 'userName', 'agree', 'createdAt']);
        allow delete: if isOwner(identifierId) || isAdmin();
      }

      // One report per user per post (reason kept private to moderators)
      match /reports/{reporterId} {
        allow create: if isOwner(reporterId) && isMember()
          && isStr(incoming().reason, 40) && optStr('details', 500);
        allow read, delete: if isAdmin();
      }
    }

    // Collection-group access to one's own likes (account deletion / export)
    match /{path=**}/likes/{likerId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
    }

    // Collection-group access to one's own comments (data export / account deletion)
    match /{path=**}/comments/{commentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ------------------------------------------------- lightweight feed index
    match /feed_thumbnails/{postId} {
      allow read: if existing().isPublic == true || isOwner(existing().userId) || isAdmin();
      allow create: if isMember()
        && incoming().userId == request.auth.uid
        && incoming().id == postId
        && get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isOwner(existing().userId) && !changedKeys().hasAny(['userId', 'id', 'likes', 'likeCount', 'commentCount']))
        || (signedIn() && changedKeys().hasOnly(['likes']) && ownLikeToggle())
        || (signedIn() && changedKeys().hasOnly(['likeCount']) && likeCounterStep(postId))
        || (signedIn() && changedKeys().hasOnly(['commentCount']) && stepOne('commentCount'));
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // ------------------------------------------------- direct messages
    // conversations/{a_b} where a < b are the two participants' uids
    function isParticipant(c) { return signedIn() && request.auth.uid in c.participants; }
    match /conversations/{cid} {
      allow read: if isParticipant(existing()) || isAdmin();
      allow create: if isMember()
        && incoming().participants is list && incoming().participants.size() == 2
        && request.auth.uid in incoming().participants
        && incoming().participants[0] < incoming().participants[1]
        && cid == incoming().participants[0] + '_' + incoming().participants[1];
      allow update: if isMember() && isParticipant(existing())
        && changedKeys().hasOnly(['lastMessage', 'updatedAt', 'lastReadAt', 'participantInfo'])
        && incoming().participants == existing().participants;

      match /messages/{mid} {
        allow read: if isParticipant(get(/databases/$(database)/documents/conversations/$(cid)).data) || isAdmin();
        allow create: if isMember()
          && isParticipant(get(/databases/$(database)/documents/conversations/$(cid)).data)
          && incoming().senderId == request.auth.uid
          && isStr(incoming().text, 2000)
          && optStr('postId', 128)
          && incoming().keys().hasOnly(['senderId', 'text', 'postId', 'createdAt'])
          // Blocked explorers cannot message the person who blocked them
          && !exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/conversations/$(cid)).data.participants[0] == request.auth.uid
                ? get(/databases/$(database)/documents/conversations/$(cid)).data.participants[1]
                : get(/databases/$(database)/documents/conversations/$(cid)).data.participants[0])/blocked/$(request.auth.uid));
        allow delete: if isOwner(existing().senderId) || isAdmin();
      }
    }

    // ------------------------------------------------- AI feedback (governance / evaluation)
    match /ai_feedback/{feedbackId} {
      allow create: if signedIn() && incoming().userId == request.auth.uid
        && incoming().kind in ['correction', 'confirmation', 'flag']
        && optStr('note', 500);
      allow read: if isAdmin();
    }

    // ------------------------------------------------- media variants (written by Cloud Functions)
    match /media_variants/{variantId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------- configuration
    match /admin_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /naturalist_profiles/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
