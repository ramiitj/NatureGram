rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ram@iitj.ac.in';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. User profiles, drafts, and notifications
    match /users/{userId} {
      // Any signed-in user can list/read (needed for admin + social features)
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      match /drafts/{draftId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Daily themes & Seed Collections.
    // Public read (app-wide display config), but writes are admin-only:
    // this is shared app configuration, not user data, and the client
    // already falls back gracefully when a write is denied (auto-seed is
    // a nice-to-have, not a requirement for normal use).
    match /themes/{themeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /daily_themes/{dateStr} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Naturalist memories (Private history log)
    match /naturalist_memories/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 4. Ecosystem feed - Main Community Posts
    match /ecosystem_feed/{postId} {
      allow read: if true;
      // Every real client session is signed in (anonymous auth included),
      // so isSignedIn() already covers legitimate seed-post creation.
      // There is no legitimate case for an unauthenticated write, so the
      // previous "postId.matches('^seed_.*')" bypass (which allowed
      // anyone, signed in or not, to create/overwrite/delete any post
      // whose id happened to start with "seed_") has been removed.
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if (
        isOwner(existing().userId) || isAdmin() ||
        // Likes/comment-count are counters any signed-in user needs to
        // bump; not forgery-proof without moving to Cloud Functions, but
        // scoped narrowly to just those two fields.
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'commentCount']))
        // NOTE: 'reports'/'reportStatus'/'reportCount' are intentionally
        // NOT in the non-owner allowlist above — there is currently no
        // report-a-post UI, so only the post owner or an admin can touch
        // those fields (which is how AdminConsole's dismissReports works).
        // If a "report this post" feature is added, extend this rule with
        // a narrow, validated allowance (e.g. only appending the caller's
        // own uid to 'reports' and only setting reportStatus to 'pending'),
        // not a blanket field-name allowlist.
      );
      allow delete: if resource == null || isOwner(existing().userId) || isAdmin();

      // 5. Comments on posts
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        // Only the comment's author (or an admin) may edit it — previously
        // any signed-in user could rewrite anyone else's comment.
        allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
        allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      }
    }

    // 6. Cached Post thumbnails
    match /feed_thumbnails/{postId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 7. System configurations (admin_config) - controls the Gemini
    // system prompt/model used for every user; admin-only.
    match /admin_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. App config - public read
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Naturalist profiles - public read
    match /naturalist_profiles/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
