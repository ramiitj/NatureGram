rules_version = '2';
// NatureGram Firestore security rules
// Principles: least privilege, owner-only content edits, counters that can only
// move by the caller's own contribution. Admin is the `admin` custom claim only, which
// can be set only with server credentials (scripts/set-admin.mjs). New sightings are
// created only by the server (/api/publish), after its checks and the daily allowance.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function isAnon() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isMember() { return signedIn() && !isAnon(); }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true && request.auth.token.email_verified == true;
    }
    function flags() { return get(/databases/$(database)/documents/app_config/flags).data; }
    function lettersOn() {
      return !exists(/databases/$(database)/documents/app_config/flags) || flags().get('lettersEnabled', true) != false;
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isStr(v, max) { return v is string && v.size() <= max; }
    function optStr(field, max) { return !(field in incoming()) || incoming()[field] == null || isStr(incoming()[field], max); }

    // Counter may move by exactly +/-1 and never below zero
    function stepOne(field) {
      let before = existing().get(field, 0);
      let after = incoming().get(field, 0);
      return after is int && after >= 0 && (after == before + 1 || after == before - 1);
    }

    // The likes array may only gain or lose the caller's own uid
    function ownLikeToggle() {
      let before = existing().get('likes', []).toSet();
      let after = incoming().get('likes', []).toSet();
      let added = after.difference(before);
      let removed = before.difference(after);
      return incoming().get('likes', []).size() == after.size() && (
        (added == [request.auth.uid].toSet() && removed.size() == 0) ||
        (removed == [request.auth.uid].toSet() && added.size() == 0)
      );
    }

    // A report moves the post's counter by one and marks it pending, only together with the caller's own
    // private report document (ecosystem_feed/{post}/reports/{uid}): one report per explorer, and the
    // reporter's identity never appears on the public post.
    function reportStep(postPath) {
      return incoming().get('reportCount', 0) == existing().get('reportCount', 0) + 1
        && incoming().reportStatus == 'pending'
        && existsAfter(/databases/$(database)/documents/ecosystem_feed/$(postPath)/reports/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/ecosystem_feed/$(postPath)/reports/$(request.auth.uid));
    }

    // likeCount may only move with the caller's own like document (batched write)
    function likeCounterStep(postPath) {
      let before = existing().get('likeCount', 0);
      let after = incoming().get('likeCount', 0);
      return after is int && after >= 0 && (
        (after == before + 1
          && existsAfter(/databases/$(database)/documents/ecosystem_feed/$(postPath)/likes/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/ecosystem_feed/$(postPath)/likes/$(request.auth.uid)))
        ||
        (after == before - 1
          && !existsAfter(/databases/$(database)/documents/ecosystem_feed/$(postPath)/likes/$(request.auth.uid))
          && exists(/databases/$(database)/documents/ecosystem_feed/$(postPath)/likes/$(request.auth.uid)))
      );
    }

    // What an author may edit on their own sighting after publishing (words, not media or the guide's words)
    function authorTextKeys() {
      return ['caption', 'title', 'description', 'tags', 'labels', 'behavior', 'ethologicalDescriptors',
              'showLocation', 'locationArea', 'isJournal', 'userName', 'userAvatar', 'searchTokens', 'observedAt'];
    }
    // Search keys are word prefixes the app recomputes after an edit (capped like the server's)
    function searchTokensOk() {
      return !('searchTokens' in incoming()) || (incoming().searchTokens is list && incoming().searchTokens.size() <= 100);
    }
    function observedAtOk() {
      return !('observedAt' in incoming()) || incoming().observedAt == null || incoming().observedAt is timestamp;
    }
    // Thank-you marks on an identification are the post author's to give; the identifier only carries them
    function keepsThanks() {
      return resource == null
        ? !('thanked' in incoming()) && !('thankedAt' in incoming())
        : incoming().get('thanked', null) == resource.data.get('thanked', null)
          && incoming().get('thankedAt', null) == resource.data.get('thankedAt', null);
    }
    // A profile's age confirmation can only ever say yes
    function ageOk() {
      return !('ageConfirmed' in incoming()) || incoming().ageConfirmed == true;
    }
    // ------------------------------------------------------------- teen mode
    // ageBand 'teen' (13 to 17) until adultFrom passes; profiles without ageBand are adults.
    // The guardian fields are written by the server only (server/guardian.js).
    function profileOf(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) ? get(/databases/$(database)/documents/users/$(uid)).data : {};
    }
    function isTeenProfile(p) {
      return p.get('ageBand', 'adult') == 'teen'
        && !(p.get('adultFrom', null) is timestamp && request.time >= p.get('adultFrom', null));
    }
    function teenApproved(p) { return p.get('guardian', {}).get('status', '') == 'approved'; }
    function isTeenUid(uid) { return isTeenProfile(profileOf(uid)); }
    // Someone the server knows as a teen can't come back as an adult by recreating their profile
    function knownTeen(uid) {
      return exists(/databases/$(database)/documents/guardian_consents/$(uid))
        && get(/databases/$(database)/documents/guardian_consents/$(uid)).data.get('status', '') != 'graduated';
    }
    function ageBandValid(d) {
      return d.ageBand in ['teen', 'adult']
        && (d.ageBand == 'teen' ? d.get('adultFrom', null) is timestamp : !('adultFrom' in d));
    }
    // At creation: an optional band (with adultFrom for a teen); never the guardian fields
    function ageBandCreateOk(uid) {
      return !incoming().keys().hasAny(['guardian', 'guardianOf'])
        && (('ageBand' in incoming()) ? ageBandValid(incoming()) : !('adultFrom' in incoming()))
        && (incoming().get('ageBand', '') == 'teen' || !knownTeen(uid));
    }
    // After creation: the band may be set once (a guest upgrading to a full account); guardian fields never
    function ageBandUpdateOk(uid) {
      return !changedKeys().hasAny(['guardian', 'guardianOf'])
        && (!changedKeys().hasAny(['ageBand', 'adultFrom'])
            || (!('ageBand' in existing()) && !('adultFrom' in existing()) && ageBandValid(incoming())
                && (incoming().ageBand == 'teen' || !knownTeen(uid))));
    }
    // A teen's sightings never say where
    function teenPlaceOk() {
      return !isTeenUid(request.auth.uid)
        || (incoming().get('showLocation', false) != true && incoming().get('locationArea', '') == '');
    }
    // Letters with a teen: only between explorers who follow each other, once a parent has said yes
    function lettersBetweenOk(a, b) {
      let pa = profileOf(a);
      let pb = profileOf(b);
      return (!isTeenProfile(pa) && !isTeenProfile(pb))
        || ((!isTeenProfile(pa) || teenApproved(pa)) && (!isTeenProfile(pb) || teenApproved(pb))
            && exists(/databases/$(database)/documents/users/$(a)/following/$(b))
            && exists(/databases/$(database)/documents/users/$(b)/following/$(a)));
    }

    // A teen writes in public (field notes, identifications, letters) only once a parent has said yes
    function teenMayTalk() {
      let p = profileOf(request.auth.uid);
      return !isTeenProfile(p) || teenApproved(p);
    }
    // Push notification switches (functions/index.js reads them). Teens always keep quiet hours.
    function notifyPrefsOk() {
      return !('notifyPrefs' in incoming())
        || (incoming().notifyPrefs is map
            && incoming().notifyPrefs.keys().hasOnly(['marvels', 'notes', 'follows', 'identifications', 'letters', 'quietHours'])
            && incoming().notifyPrefs.values().hasOnly([true, false])
            && (!isTeenProfile(incoming()) || incoming().notifyPrefs.get('quietHours', true) == true));
    }

    // Changing the picture takes the sighting out of the feed until the server checks it again.
    // mediaPaths: the clips' storage paths, kept in step with a new clip (the poster function finds posts by them)
    function authorMediaEdit() {
      return changedKeys().hasOnly(authorTextKeys().concat(['imageUrl', 'videoUrl', 'audioUrl', 'thumbnailUrl', 'thumbSmallUrl', 'rotation', 'items', 'isPublic', 'moderation', 'mediaPaths']))
        && (!('mediaPaths' in changedKeys()) || (incoming().mediaPaths is list && incoming().mediaPaths.size() <= 24))
        && incoming().isPublic == false
        && incoming().moderation.keys().hasOnly(['status'])
        && incoming().moderation.status == 'edited';
    }

    // ------------------------------------------------------------------ users
    match /users/{userId} {
      // Counts (stats.species, stats.sightings, stats.reconciledAt) are the server's alone; a new
      // profile may start them at zero and nothing else (server/userStats.js keeps them true)
      function freshStats() {
        return !('stats' in incoming())
          || (incoming().stats is map
              && incoming().stats.keys().hasOnly(['observations', 'species', 'sightings'])
              && incoming().stats.get('observations', 0) == 0
              && incoming().stats.get('species', 0) == 0
              && incoming().stats.get('sightings', 0) == 0);
      }
      allow get: if signedIn();
      allow list: if isAdmin() || (signedIn() && request.query.limit <= 50);
      allow create: if isOwner(userId)
        && incoming().uid == userId
        && !incoming().keys().hasAny(['admin', 'role', 'verified', 'followersCount', 'followingCount'])
        && freshStats()
        && isStr(incoming().username, 40) && ageOk() && ageBandCreateOk(userId) && notifyPrefsOk()
        && optStr('bio', 300) && optStr('avatarUrl', 2048) && optStr('displayName', 60);
      allow update: if isAdmin()
        || (isOwner(userId)
            && !changedKeys().hasAny(['uid', 'admin', 'role', 'verified', 'joinedAt', 'followersCount', 'stats'])
            && (!('followingCount' in changedKeys()) || stepOne('followingCount'))
            && ageOk() && ageBandUpdateOk(userId) && notifyPrefsOk()
            && optStr('username', 40) && optStr('usernameLower', 40) && optStr('bio', 300) && optStr('avatarUrl', 2048) && optStr('displayName', 60))
        // Followers counter: only moves with the caller's own follower doc (batched write)
        || (isMember() && !isOwner(userId)
            && changedKeys().hasOnly(['followersCount'])
            && stepOne('followersCount')
            && (
              (incoming().followersCount > existing().get('followersCount', 0)
                && existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && !exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)))
              ||
              (incoming().followersCount < existing().get('followersCount', 0)
                && !existsAfter(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid))
                && exists(/databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)))
            ));
      allow delete: if isOwner(userId) || isAdmin();

      match /drafts/{draftId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Private per-user data (settings, precise locations, consent)
      match /private/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) && changedKeys().hasOnly(['isRead']);
        allow create: if isAdmin() || (
          isMember() && !isOwner(userId)
          && incoming().senderId == request.auth.uid
          && incoming().type in ['like', 'comment', 'follow', 'mention', 'reply', 'message', 'identification']
          && isStr(incoming().message, 300)
          && optStr('senderName', 60) && optStr('postId', 128) && optStr('senderAvatar', 2048)
          && incoming().isRead == false
          && incoming().keys().hasOnly(['type', 'message', 'postId', 'senderId', 'senderName', 'senderAvatar', 'timestamp', 'isRead'])
        );
      }

      // Social graph: users/{A}/following/{B} and users/{B}/followers/{A}
      match /following/{targetId} {
        allow read: if signedIn();
        allow create, delete: if isOwner(userId) && isMember() && targetId != userId;
      }
      match /followers/{followerId} {
        allow read: if signedIn();
        allow create, delete: if isOwner(followerId) && isMember() && followerId != userId;
      }

      match /blocked/{targetId} {
        allow read, write: if isOwner(userId);
      }
      // Muted explorers: private to the person who muted (the muted explorer never knows)
      match /muted/{targetId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && targetId != userId
          && incoming().keys().hasOnly(['createdAt']);
      }
      match /saved/{postId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ------------------------------------------------- themes (public, admin-managed)
    match /themes/{themeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /daily_themes/{dateStr} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------- naturalist memories (private)
    match /naturalist_memories/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ------------------------------------------------- posts
    match /ecosystem_feed/{postId} {
      allow read: if existing().isPublic == true || isOwner(existing().userId) || isAdmin();

      // Created only by the server, after its checks and the daily allowance
      allow create: if false;

      allow update: if isAdmin()
        || (isOwner(existing().userId)
            && optStr('caption', 2200) && optStr('title', 200) && optStr('description', 5000)
            && searchTokensOk() && observedAtOk() && teenPlaceOk()
            && (
              // words only; visibility may only be switched off here (on goes through the server)
              (changedKeys().hasOnly(authorTextKeys().concat(['isPublic'])) && (!('isPublic' in changedKeys()) || incoming().isPublic == false))
              || authorMediaEdit()
            ))
        || (signedIn() && changedKeys().hasOnly(['likes']) && ownLikeToggle())
        || (signedIn() && changedKeys().hasOnly(['likeCount']) && likeCounterStep(postId))
        || (signedIn() && changedKeys().hasOnly(['commentCount']) && stepOne('commentCount'))
        || (isMember() && changedKeys().hasOnly(['reportStatus', 'reportCount']) && reportStep(postId));

      // One like document per explorer (id = uid); readable for "liked by" lists
      match /likes/{likerId} {
        allow read: if get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.isPublic == true
          || isOwner(get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.userId)
          || isOwner(likerId) || isAdmin();
        allow create: if isOwner(likerId) && incoming().userId == request.auth.uid
          && incoming().keys().hasOnly(['userId', 'createdAt'])
          && existsAfter(/databases/$(database)/documents/ecosystem_feed/$(postId))
          && getAfter(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.get('likeCount', 0) == get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.get('likeCount', 0) + 1;
        allow delete: if (isOwner(likerId)
          && getAfter(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.get('likeCount', 0) == get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.get('likeCount', 0) - 1)
          || isAdmin();
      }

      allow delete: if isOwner(existing().userId) || isAdmin();

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.isPublic == true
          || isOwner(get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.userId)
          || isAdmin();
        allow create: if isMember() && teenMayTalk()
          && incoming().userId == request.auth.uid
          && isStr(incoming().text, 1000) && incoming().text.size() > 0
          && optStr('userName', 60) && optStr('parentId', 128) && optStr('avatarUrl', 2048)
          && incoming().keys().hasOnly(['userId', 'userName', 'text', 'timestamp', 'parentId', 'avatarUrl']);
        allow update: if isOwner(existing().userId)
          && changedKeys().hasOnly(['text', 'editedAt'])
          && isStr(incoming().text, 1000) && incoming().text.size() > 0;
        allow delete: if isOwner(existing().userId)
          || isOwner(get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.userId)
          || isAdmin();
      }

      // Community identification: one ID per explorer per post (agree or suggest)
      match /identifications/{identifierId} {
        allow read: if get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.isPublic == true
          || isOwner(get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.userId)
          || isAdmin();
        allow create, update: if isOwner(identifierId) && isMember() && teenMayTalk()
          && isStr(incoming().name, 80) && incoming().name.size() > 0
          && optStr('scientificName', 80) && optStr('note', 280) && optStr('userName', 60)
          && incoming().keys().hasOnly(['name', 'scientificName', 'note', 'userName', 'userId', 'agree', 'createdAt', 'thanked', 'thankedAt'])
          // userId (newer apps) lets account deletion find an explorer's identifications
          && (!('userId' in incoming()) || incoming().userId == request.auth.uid)
          // The identifier can keep a thank-you when re-saving, never award one
          && keepsThanks();
        // The post's author can thank an identifier (and only that)
        allow update: if isMember() && !isOwner(identifierId)
          && isOwner(get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.userId)
          && changedKeys().hasOnly(['thanked', 'thankedAt'])
          && incoming().thanked == true;
        allow delete: if isOwner(identifierId) || isAdmin();
      }

      // One report per user per post (reason and reporter kept private to moderators). Created only
      // together with the post's counter step (see reportStep), so every report reaches the queue.
      match /reports/{reporterId} {
        allow create: if isOwner(reporterId) && isMember()
          && isStr(incoming().reason, 40) && incoming().reason.size() > 0 && optStr('details', 500)
          && incoming().keys().hasOnly(['reason', 'details', 'createdAt'])
          && getAfter(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.get('reportCount', 0)
             == get(/databases/$(database)/documents/ecosystem_feed/$(postId)).data.get('reportCount', 0) + 1;
        // The reporter may check their own (so the app can say "you already reported this")
        allow get: if isOwner(reporterId);
        allow read, delete: if isAdmin();
      }
    }

    // Collection-group access to one's own likes (account deletion / export)
    match /{path=**}/likes/{likerId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
    }

    // Collection-group access to one's own comments (data export / account deletion)
    match /{path=**}/comments/{commentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ------------------------------------------------- lightweight feed index
    match /feed_thumbnails/{postId} {
      allow read: if existing().isPublic == true || isOwner(existing().userId) || isAdmin();
      // Written by the server when a checked sighting joins the feed
      allow create: if false;
      allow update: if isAdmin()
        || (isOwner(existing().userId) && changedKeys().hasOnly(['caption', 'title', 'description', 'tags', 'labels', 'behavior', 'ethologicalDescriptors', 'locationArea', 'userName', 'userAvatar', 'searchTokens']) && searchTokensOk() && teenPlaceOk())
        || (signedIn() && changedKeys().hasOnly(['likes']) && ownLikeToggle())
        || (signedIn() && changedKeys().hasOnly(['likeCount']) && likeCounterStep(postId))
        || (signedIn() && changedKeys().hasOnly(['commentCount']) && stepOne('commentCount'));
      allow delete: if isOwner(existing().userId) || isAdmin();
    }

    // ------------------------------------------------- direct messages
    // conversations/{a_b} where a < b are the two participants' uids
    function isParticipant(c) { return signedIn() && request.auth.uid in c.participants; }
    // Admins never read letters here; reported conversations are read through the admin API only.
    match /conversations/{cid} {
      allow read: if isParticipant(existing());
      allow create: if isMember() && lettersOn() && teenMayTalk()
        && incoming().participants is list && incoming().participants.size() == 2
        && request.auth.uid in incoming().participants
        && incoming().participants[0] < incoming().participants[1]
        && cid == incoming().participants[0] + '_' + incoming().participants[1]
        && lettersBetweenOk(incoming().participants[0], incoming().participants[1]);
      allow update: if isMember() && isParticipant(existing())
        && changedKeys().hasOnly(['lastMessage', 'updatedAt', 'lastReadAt', 'participantInfo'])
        && incoming().participants == existing().participants;

      match /messages/{mid} {
        allow read: if isParticipant(get(/databases/$(database)/documents/conversations/$(cid)).data);
        allow create: if isMember() && lettersOn() && teenMayTalk()
          && isParticipant(get(/databases/$(database)/documents/conversations/$(cid)).data)
          && incoming().senderId == request.auth.uid
          && isStr(incoming().text, 2000)
          && optStr('postId', 128)
          && incoming().keys().hasOnly(['senderId', 'text', 'postId', 'createdAt'])
          && lettersBetweenOk(get(/databases/$(database)/documents/conversations/$(cid)).data.participants[0], get(/databases/$(database)/documents/conversations/$(cid)).data.participants[1])
          // Blocked explorers cannot message the person who blocked them
          && !exists(/databases/$(database)/documents/users/$(get(/databases/$(database)/documents/conversations/$(cid)).data.participants[0] == request.auth.uid
                ? get(/databases/$(database)/documents/conversations/$(cid)).data.participants[1]
                : get(/databases/$(database)/documents/conversations/$(cid)).data.participants[0])/blocked/$(request.auth.uid));
        allow delete: if isOwner(existing().senderId) || isAdmin();
      }
    }

    // A participant can report a conversation; only then can the admin read it (through the server)
    match /letter_reports/{reportId} {
      allow create: if isMember()
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open'
        && isStr(incoming().cid, 260)
        && isStr(incoming().reason, 40) && optStr('details', 500)
        && incoming().keys().hasOnly(['cid', 'reporterId', 'reason', 'details', 'status', 'createdAt'])
        && isParticipant(get(/databases/$(database)/documents/conversations/$(incoming().cid)).data);
      allow read, update, delete: if false;
    }

    // Reports on a field note (comment) or an explorer's profile. One per reporter per target (the id
    // says which); the reporter can check their own, nobody else can read them (the admin reads them
    // through the server, /api/admin/content-reports).
    match /content_reports/{reportId} {
      allow create: if isMember()
        && incoming().reporterId == request.auth.uid
        && incoming().status == 'open'
        && isStr(incoming().reason, 40) && incoming().reason.size() > 0 && optStr('details', 500)
        && incoming().keys().hasOnly(['kind', 'postId', 'commentId', 'reportedUid', 'reporterId', 'reason', 'details', 'status', 'createdAt'])
        && (
          (incoming().kind == 'comment'
            && isStr(incoming().postId, 128) && isStr(incoming().commentId, 128)
            && reportId == 'c_' + incoming().postId + '_' + incoming().commentId + '_' + request.auth.uid
            && exists(/databases/$(database)/documents/ecosystem_feed/$(incoming().postId)/comments/$(incoming().commentId))
            && optStr('reportedUid', 128))
          ||
          (incoming().kind == 'profile'
            && isStr(incoming().reportedUid, 128) && incoming().reportedUid != request.auth.uid
            && reportId == 'u_' + incoming().reportedUid + '_' + request.auth.uid
            && !incoming().keys().hasAny(['postId', 'commentId']))
        );
      allow get: if isMember() && reportId.matches('^[cu]_.+_' + request.auth.uid + '$')
        && (resource == null || resource.data.reporterId == request.auth.uid);
      allow list, update, delete: if false;
    }

    // ------------------------------------------------- AI feedback (governance / evaluation)
    match /ai_feedback/{feedbackId} {
      allow create: if signedIn() && incoming().userId == request.auth.uid
        && incoming().kind in ['correction', 'confirmation', 'flag']
        && optStr('note', 500);
      allow read: if isAdmin();
    }

    // ------------------------------------------------- media variants (written by Cloud Functions)
    match /media_variants/{variantId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------- configuration
    // Legacy console settings (no longer used by the AI; prompts now live on the server)
    match /admin_config/{configId} {
      allow read, write: if isAdmin();
    }
    // Feature flags and experiments: everyone reads (the app decides variants locally); only the admin writes
    // (the admin console goes through the server, which keeps history and an audit trail).
    // Admin jobs (e.g. the poster backfill): started and watched from the admin console, run by a Cloud Function
    match /admin_jobs/{jobId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.kind in ['posters']
        && request.resource.data.status in ['requested', 'stopped'];
      allow delete: if false;
    }
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Public switches and allowances. Changed only through the admin API, which keeps history and an audit trail.
    match /app_config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------- server-only records
    // Prompts, policy, models, history; usage counters; AI activity; the guide's answers;
    // suspensions; review queue; audit log. Clients can neither read nor write them.
    match /admin_private/{document=**} { allow read, write: if false; }
    match /ai_usage/{id} { allow read, write: if false; }
    match /usage_global/{id} { allow read, write: if false; }
    match /ai_log/{id} { allow read, write: if false; }
    match /ai_results/{id} { allow read, write: if false; }
    match /suspended/{id} { allow read, write: if false; }
    match /review_queue/{id} { allow read, write: if false; }
    match /admin_audit/{id} { allow read, write: if false; }
    match /live_leases/{id} { allow read, write: if false; }
    // Teen mode: parents' links (token hashes), consent records, and accounts a parent asked to close
    match /guardian_requests/{id} { allow read, write: if false; }
    match /guardian_consents/{id} { allow read, write: if false; }
    match /deletion_requests/{id} { allow read, write: if false; }
    match /naturalist_profiles/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
