{
  "appId": "com.thenaturegram.app",
  "appName": "NatureGram",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorHttp": { "enabled": false },
    "SplashScreen": { "launchShowDuration": 800, "backgroundColor": "#1c1917", "showSpinner": false }
  }
}
