# Required: Gemini API key (store in Secret Manager in production, never commit)
GEMINI_API_KEY=

# Optional
# PORT=3000
# PUBLIC_HOST=thenaturegram.com
# ALLOWED_ORIGINS=https://staging.thenaturegram.com

# AI governance: model pinning
# LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest
# LIVE_ALLOWED_MODELS=
# GEMINI_ALLOWED_MODELS=gemini-3.1-pro-preview,gemini-3.1-flash-preview

# AI quotas (per user, per day; per server instance)
# QUOTA_USER_HTTP_PER_DAY=300
# QUOTA_USER_LIVE_MIN_PER_DAY=90
# QUOTA_ANON_HTTP_PER_DAY=40
# QUOTA_ANON_LIVE_MIN_PER_DAY=20
# QUOTA_HTTP_PER_MIN=20
# QUOTA_MAX_CONCURRENT_LIVE=2
# LIVE_SESSION_MAX_MIN=15

# Web push (public VAPID key from Firebase console → Cloud Messaging)
# VITE_FCM_VAPID_KEY=

# AI task → model routing (server-side; change/roll back without a client release)
# MODEL_IDENTIFY=gemini-3.1-pro-preview
# MODEL_SYNTHESIZE=gemini-3.1-pro-preview

# --- Governance release ---
# Firebase Admin credentials (JSON) when Cloud Run runs outside the Firebase project
# FIREBASE_SERVICE_ACCOUNT=
# The admin's Firebase uid (only this account can open the admin console)
# ADMIN_UIDS=
# ADMIN_EMAIL=ram@iitj.ac.in
# ADMIN_SESSION_HOURS=12
# Allow AI and sharing when the database is unreachable (local development only)
# QUOTA_FAIL_OPEN=false

# --- Search and AI discoverability (docs/SEO.md) ---
# AI crawlers in robots.txt: allow (default) | search-only (cite, don't train) | deny
# AI_CRAWLERS=allow
# IndexNow key (8-128 letters, digits or hyphens); served at /<key>.txt, pinged on each public post
# INDEXNOW_KEY=
# How many recent public sightings feed species pages and sitemaps (rebuilt hourly)
# SEO_CORPUS_LIMIT=2000
# Store listings, once published (adds MobileApplication structured data)
# IOS_APP_URL=
# ANDROID_APP_URL=
