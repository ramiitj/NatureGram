GEMINI_API_KEY=

# Optional Live session quotas (defaults: 1 concurrent, 20/day per user)
MAX_CONCURRENT_LIVE_SESSIONS=
MAX_DAILY_LIVE_SESSIONS=

# Optional Sentry error monitoring — leave both unset to disable entirely
# (zero-cost: the client SDK is fully tree-shaken out of the production
# bundle when VITE_SENTRY_DSN is unset at build time).
# SENTRY_DSN is read at server runtime (process.env); VITE_SENTRY_DSN must
# be set at BUILD time for the client bundle (Vite inlines import.meta.env
# values when `npm run build` runs, not at server-start time).
SENTRY_DSN=
VITE_SENTRY_DSN=
